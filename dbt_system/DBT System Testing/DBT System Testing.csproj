<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<OutputType>Exe</OutputType>
	<RootNamespace>DBT_System_Testing</RootNamespace>
	<PackageId>DBT.System.Testing</PackageId>
	<Version>1.0.0</Version>
	<Authors>Erick Ponciano</Authors>
	<Company>Cosmos (CSM)</Company>
	<RepositoryUrl>https://github.com/Cosmos-CSM/dbt_system</RepositoryUrl>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<PackageReadmeFile>CHANGELOG.md</PackageReadmeFile>
	<IsPackable>true</IsPackable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSM.Database.Testing" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBT System\DBT System.csproj" />
  </ItemGroup>
	
  <ItemGroup>
    <None Include="CHANGELOG.md" Pack="true" PackagePath="" />
  </ItemGroup>


  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>